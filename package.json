{
  "name": "linestepper",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @linestepper/api",
    "dev:mobile": "npm run start -w @linestepper/mobile",
    "dev:web": "npm run dev -w @linestepper/web",
    "build:api": "npm run build -w @linestepper/api",
    "start": "npm run start -w @linestepper/api",
    "heroku-postbuild": "npm run build:api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:functions",
    "test:functions": "vitest run --root supabase/functions",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.5",
    "glob@^13.0.0": "^14.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
