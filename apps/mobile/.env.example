# Copy to .env and fill in from your Supabase project settings (Settings → API).
# EXPO_PUBLIC_ vars are embedded in the client bundle — anon key only, never the
# service role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# LineStepper API (apps/api). Leave empty to run without it: flags fall back to
# their defaults and logs go to the console only.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Optional: Sentry DSN for crash reporting (crashes can't reliably reach our API).
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (analytics + error tracking). Leave empty to keep telemetry local.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
