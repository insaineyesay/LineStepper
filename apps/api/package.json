{
  "name": "@linestepper/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LineStepper API: feature flags, log ingest, and (later) the domain modules. Deployed to Heroku.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@linestepper/shared": "*",
    "@sentry/node": "^11.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
