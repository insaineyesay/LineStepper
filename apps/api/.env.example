# Copy to apps/api/.env for local dev. On Heroku set these as config vars.
PORT=4000
NODE_ENV=development
APP_VERSION=dev

# Comma-separated origins allowed to call the API from a browser (Expo web, dashboard).
CORS_ORIGINS=http://localhost:8082,http://localhost:3000

# --- Auth (pluggable): supabase | none
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: server only, never in a client bundle. Used for flags + admin lookups.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy shared JWT secret. Leave empty to verify
# tokens against the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

# --- Feature flags: deploy-time overrides on top of the registry defaults.
# Runtime changes made by admins (stored in Supabase) win over these.
# Example: FLAGS=booking=on,notify.sms=off
FLAGS=

# --- Logging connectors (stdout is always on). Each is also gated by its
# log.connector.* flag, so it can be switched off without a deploy.
LOG_LEVEL=info
# Papertrail / SolarWinds HTTP ingestion token. If you use the Heroku Papertrail
# add-on instead (which drains stdout), leave this empty to avoid duplicates.
PAPERTRAIL_TOKEN=
PAPERTRAIL_URL=https://logs.collector.solarwinds.com/v1/logs
SENTRY_DSN=
# PostHog (analytics + error tracking). Project API key, starts with phc_.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
